<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Header: App Name and Location -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:fontFamily="@font/poppins"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Solat Malaysia by Dr. Aizzat"
            android:textColor="#E0F2F1"
            android:textSize="11sp"
            android:textStyle="italic" />

        <TextView
            android:fontFamily="@font/poppins_bold"
            android:id="@+id/widget_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:drawableStart="@android:drawable/ic_menu_mylocation"
            android:drawablePadding="4dp" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <!-- Center: Next Prayer prominently displayed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:fontFamily="@font/poppins_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXT PRAYER"
            android:textColor="#E0F2F1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="4dp">

            <TextView
                android:fontFamily="@font/poppins_bold"
                android:id="@+id/widget_next_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#FFD100"
                android:textSize="32sp"
                android:textStyle="bold"/>

            <TextView
                android:fontFamily="@font/poppins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" - "
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:fontFamily="@font/poppins_bold"
                android:id="@+id/widget_next_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <!-- Bottom: All 5 Prayers in a sleek rounded translucent bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_inner_background"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:weightSum="5">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:fontFamily="@font/poppins_bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FAJR" android:textColor="#B2DFDB" android:textSize="9sp" android:textStyle="bold"/>
            <TextView android:fontFamily="@font/poppins_bold" android:id="@+id/widget_fajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:fontFamily="@font/poppins_bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DHUHR" android:textColor="#B2DFDB" android:textSize="9sp" android:textStyle="bold"/>
            <TextView android:fontFamily="@font/poppins_bold" android:id="@+id/widget_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:fontFamily="@font/poppins_bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ASR" android:textColor="#B2DFDB" android:textSize="9sp" android:textStyle="bold"/>
            <TextView android:fontFamily="@font/poppins_bold" android:id="@+id/widget_asr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:fontFamily="@font/poppins_bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAGHRIB" android:textColor="#B2DFDB" android:textSize="9sp" android:textStyle="bold"/>
            <TextView android:fontFamily="@font/poppins_bold" android:id="@+id/widget_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:fontFamily="@font/poppins_bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ISHA" android:textColor="#B2DFDB" android:textSize="9sp" android:textStyle="bold"/>
            <TextView android:fontFamily="@font/poppins_bold" android:id="@+id/widget_isha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
